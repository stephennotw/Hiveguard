{
  "name": "hiveguard",
  "version": "2.0.0",
  "description": "Read-only endpoint scanner for supply-chain compromise, malicious install scripts, persistence and AI tooling, with live threat intelligence",
  "main": "bin/hiveguard.js",
  "bin": {
    "hiveguard": "./bin/hiveguard.js"
  },
  "scripts": {
    "scan": "node bin/hiveguard.js",
    "test": "node --test test/*.test.js",
    "self-check": "node tools/self-check.js",
    "test:corpus:update": "HIVEGUARD_UPDATE_CORPUS=1 node --test test/corpus.test.js"
  },
  "keywords": [
    "supply-chain",
    "security",
    "scanner",
    "threat-intel",
    "sbom",
    "npm",
    "pypi",
    "vulnerability",
    "ioc",
    "persistence",
    "mcp",
    "cyclonedx",
    "sarif"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {}
}
